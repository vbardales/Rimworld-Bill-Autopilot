<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Step definitions for the Pickle suite in ../Mod/Pickle/Features. Only Pickle loads this
    assembly: it lives in the companion test mod, never in the Mod/ folder that goes to the
    Workshop. Mirrors SkillIcons/Tests/Pickle/Source and WorkStudio/Tests/Pickle/Source.

    Nothing here references an optional integration at compile time. Bill Autopilot itself reaches
    Better Workbench Management, Nice Bill Tab and the others by reflection precisely so that their
    absence costs a feature and never a load error; a test assembly that bound them for real would
    fail to load in the very pass meant to prove the mod stands alone.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>BillAutopilot.PickleSteps</AssemblyName>
    <RootNamespace>BillAutopilot.PickleSteps</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <OutputPath>..\Mod\Pickle\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time stubs only: the game, Harmony and the Pickle mod supply the real assemblies. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Krafs.Publicizer" Version="2.*" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RimWorks.Pickle.Ref" Version="4.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The same publicizer the mod itself builds with, and for the same member: a bill's custom name
      is not public in Assembly-CSharp, and it is exactly what the per-bench memory has to hand back
      after a down-and-up cycle. Reading it by reflection instead would work too, and would move the
      failure from build time to the middle of a WSL run.
    -->
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bound by name at run time: RimWorld loads Bill Autopilot before Pickle loads this assembly.
         The shipped assembly is referenced, not a copy, so a step that names a field the mod has
         since renamed fails at build rather than at 2 a.m. in a WSL run. -->
    <Reference Include="BillAutopilot">
      <HintPath>..\..\..\Mod\Assemblies\BillAutopilot.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
